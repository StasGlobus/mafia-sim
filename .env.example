# --- Model access -----------------------------------------------------------
# Optional locally. On Vercel, leaving it empty uses Vercel AI Gateway (OIDC).
# Without a key and off Vercel, agents fall back to canned Hebrew lines.
OPENAI_API_KEY=
# Optional. gpt-4.1-mini is the default; gpt-4.1 gives better Hebrew grammar.
MAFIA_MODEL=
# Set to 1 to force canned lines (useful for tests and offline work).
MAFIA_DISABLE_LLM=

# --- Persistence (Supabase) -------------------------------------------------
# Project URL from Supabase > Project Settings > Data API.
SUPABASE_URL=
# Secret key (sb_secret_...) or the legacy service_role key. Server only.
# Never expose this to the browser; game state contains roles and secrets.
SUPABASE_SECRET_KEY=
# Only for `npm run db:migrate` (local use, not needed on Vercel).
# Project Settings > Database > Connection string (URI).
SUPABASE_DB_URL=

# --- Cron ---------------------------------------------------------------------
# Protects /api/live/cron. Vercel sends it automatically as a Bearer token.
CRON_SECRET=
